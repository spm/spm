# Makefile default variables

SHELL       = /bin/sh
MAKE        = make
MOSUF       = o
SOSUF       = so
AR          = ar rcs
COPY        = cp -f
DEL         = rm -f
MOVE        = mv -f
MKDIR       = mkdir
TAR         = tar
ZIP         = gzip -f
OMPFLAG     = -fopenmp
WARNFLAG    = -Wall -Wextra -Wpedantic
USE_OPENMP ?= 0
SONAME      = soname
NVCC        = nvcc
PTXDIR      = ../lib/ptx

ifndef PLATFORM
  PLATFORM = $(shell uname)
  ifeq (Darwin,$(PLATFORM))
    ifeq (arm64,$(shell uname -m)) # Check for Apple Silicon
      PLATFORM = arm64
    endif
  endif
endif


##### Linux #####
ifeq (Linux,$(PLATFORM))
  LIBDIR  = ../lib/liba64
  CC      = gcc
  NVCC   += -m64
endif


##### macOS #####
ifeq (Darwin,$(PLATFORM))
  LIBDIR  = ../lib/libmaci64
  MOSUF   = o
  SOSUF   = dylib
  # https://stackoverflow.com/questions/37362414/
  OMPFLAG = -fopenmp=libiomp5
  CC      = gcc
  NVCC   += -m64
  SONAME  = install_name
endif

ifeq (arm64,$(PLATFORM))
  LIBDIR  = ../lib/libmaca64
  MOSUF   = o
  SOSUF   = dylib
  # https://stackoverflow.com/questions/37362414/
  OMPFLAG = -fopenmp=libiomp5
  CC      = gcc
  NVCC   += -m64
  SONAME  = install_name
endif


##### Windows #####
ifeq (MINGW64,$(word 1,$(subst _, ,$(PLATFORM)))) # MSVC
  LIBDIR  = ../lib/libw64
  MOSUF   = obj
  SOSUF   = dll
  CC      = x86_64-w64-mingw32-gcc-win32
  NVCC    = nvcc.exe -m64
endif

ifeq (MSYS,$(word 1,$(subst _, ,$(PLATFORM)))) # GCC
  LIBDIR  = ../lib/libw64
  MOSUF   = obj
  SOSUF   = dll
  NVCC    = nvcc.exe -m64
endif


#### Otherwise ####
ifndef LIBDIR
  $(error Unknowm platform $(PLATFORM))
endif


ifeq (1,$(USE_OPENMP))
  ifneq ($(OMPFLAG),)
  endif
endif


define verb
	@ echo "_____________________________________________________________"
	@ echo ""
	@ echo "        " $(1)
	@ echo "_____________________________________________________________"
	@ echo ""
endef
